<template>
  <div class="page" @swipe="blockSystemBack">
    <text class="page-title">{{isSaveMode ? '保存进度' : '读取进度'}}</text>
    <text class="page-subtitle">{{isSaveMode ? '点击覆盖，长按删除' : '点按读取，长按删除'}}</text>
    <list class="save-list" if="{{autoSaveRow || saveRows.length}}">
      <list-item type="auto" class="save-item auto-save-item" @click="selectAutoSave">
        <text class="slot-title">自动存档</text>
        <div class="slot-meta">
          <text class="slot-info">{{autoSaveRow.info}}</text>
          <text class="slot-time">{{autoSaveRow.savedTime}}</text>
        </div>
      </list-item>
      <list-item type="save" class="save-item" for="{{saveRows}}" @click="selectSlot($idx)" @longpress="requestDeleteSlot($idx)">
        <text class="slot-title">存档 {{$idx + 1}}</text>
        <div class="slot-meta">
          <text class="slot-info">场景 {{$item.sceneNumber}}</text>
          <text class="slot-time">{{$item.savedTime}}</text>
        </div>
      </list-item>
      <list-item type="new" class="save-item add-item" if="{{isSaveMode && pendingSave}}" @click="saveNew">
        <text class="slot-title">新建存档</text>
      </list-item>
    </list>
    <div class="empty" if="{{isSaveMode && !saveRows.length}}">
      <text class="empty-text">{{isSaveMode ? '还没有存档' : '暂无可读取的存档'}}</text>
      <text class="new-btn" if="{{isSaveMode && pendingSave}}" @click="saveNew">新建存档</text>
    </div>
    <text class="back-btn" @click="back">返回</text>
    <div class="delete-scrim" if="{{deleteSlotIndex >= 0}}"></div>
    <div class="delete-dialog" if="{{deleteSlotIndex >= 0}}">
      <text class="delete-title">删除存档？</text>
      <text class="delete-copy">此操作无法撤销</text>
      <div class="delete-actions">
        <text class="delete-cancel" @click="cancelDelete">取消</text>
        <text class="delete-confirm" @click="confirmDelete">删除</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'

export default {
  protected: { mode: 'load' },
  private: { recoveryData: [], autoSaveData: null, autoSaveRow: { info: '暂无自动存档', savedTime: '' }, saveRows: [], pendingSave: null, isSaveMode: false, deleteSlotIndex: -1, suppressedSlotClick: -1 },
  onInit() {
    this.isSaveMode = this.mode === 'save'
    storage.get({
      key: 'recoveryData',
      success: (data) => {
        try { this.recoveryData = Array.isArray(JSON.parse(data)) ? JSON.parse(data) : [] } catch (error) { this.recoveryData = [] }
        this.refreshSaveRows()
      },
      fail: () => { this.recoveryData = []; this.refreshSaveRows() }
    })
    storage.get({
      key: 'autoSave',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          this.autoSaveData = Number.isInteger(Number(saved && saved.currentScene)) && Number(saved.currentScene) >= 0 ? saved : null
        } catch (error) { this.autoSaveData = null }
        this.refreshAutoSaveRow()
      },
      fail: () => { this.autoSaveData = null; this.refreshAutoSaveRow() }
    })
    if (this.isSaveMode) {
      storage.get({
        key: 'pendingSave',
        success: (data) => { try { this.pendingSave = JSON.parse(data) } catch (error) { this.pendingSave = null } },
        fail: () => { this.pendingSave = null }
      })
    }
  },
  selectSlot(index) {
    const slot = Number(index)
    if (slot === this.suppressedSlotClick) { this.suppressedSlotClick = -1; return }
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot] || (this.isSaveMode && !this.pendingSave)) return
    if (this.isSaveMode) return this.saveAt(slot)
    router.push({ uri: 'pages/detail', params: { load: String(slot) } })
  },
  selectAutoSave() {
    if (this.isSaveMode || !this.autoSaveData) return
    router.push({ uri: 'pages/detail', params: { auto: '1' } })
  },
  saveAt(slot) {
    if (!this.pendingSave) return prompt.showToast({ message: '当前进度不可保存' })
    const updated = this.recoveryData.slice()
    updated[slot] = this.freshPendingSave()
    this.persist(updated, '覆盖成功')
  },
  saveNew() {
    if (!this.pendingSave) return prompt.showToast({ message: '当前进度不可保存' })
    this.persist(this.recoveryData.concat([this.freshPendingSave()]), '保存成功')
  },
  requestDeleteSlot(index) {
    const slot = Number(index)
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot]) return
    this.suppressedSlotClick = slot
    this.deleteSlotIndex = slot
  },
  cancelDelete() { this.deleteSlotIndex = -1; this.suppressedSlotClick = -1 },
  confirmDelete() {
    const slot = this.deleteSlotIndex
    this.suppressedSlotClick = -1
    if (!Number.isInteger(slot) || slot < 0 || !this.recoveryData[slot]) return
    this.deleteSlotIndex = -1
    const updated = this.recoveryData.slice()
    updated.splice(slot, 1)
    storage.set({
      key: 'recoveryData',
      value: JSON.stringify(updated),
      success: () => { this.recoveryData = updated; this.refreshSaveRows(); prompt.showToast({ message: '已删除' }) },
      fail: () => prompt.showToast({ message: '删除失败' })
    })
  },
  persist(data, message) {
    storage.set({
      key: 'recoveryData',
      value: JSON.stringify(data),
      success: () => {
        this.recoveryData = data
        this.refreshSaveRows()
        prompt.showToast({ message })
      },
      fail: () => prompt.showToast({ message: '保存失败' })
    })
  },
  freshPendingSave() { return Object.assign({}, this.pendingSave, { savedAt: Date.now() }) },
  refreshSaveRows() {
    this.saveRows = (this.recoveryData || []).map((save) => ({
      sceneNumber: Number.isInteger(Number(save && save.currentScene)) ? Number(save.currentScene) + 1 : 1,
      savedTime: this.formatSavedAt(save && save.savedAt)
    }))
  },
  refreshAutoSaveRow() {
    const saved = this.autoSaveData
    const valid = Number.isInteger(Number(saved && saved.currentScene)) && Number(saved.currentScene) >= 0
    this.autoSaveRow = valid ? { info: `场景 ${Number(saved.currentScene) + 1}`, savedTime: this.formatSavedAt(saved.savedAt) } : { info: '暂无自动存档', savedTime: '' }
  },
  formatSavedAt(value) {
    const savedAt = Number(value)
    if (!Number.isFinite(savedAt) || savedAt <= 0) return '时间未知'
    const date = new Date(savedAt)
    const month = this.twoDigits(date.getMonth() + 1)
    const day = this.twoDigits(date.getDate())
    const hours = this.twoDigits(date.getHours())
    const minutes = this.twoDigits(date.getMinutes())
    return `${month}-${day} ${hours}:${minutes}`
  },
  twoDigits(value) { return value < 10 ? `0${value}` : String(value) },
  blockSystemBack() {},
  back() { storage.delete({ key: 'pendingSave', success: () => {}, fail: () => {} }); router.back() }
}
</script>

<style>
.page { width: 212px; height: 520px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { width: 100%; height: 65px; line-height: 65px; color: #ffffff; font-size: 26px; font-weight: bold; text-align: center; }
.page-subtitle { width: 180px; height: 28px; line-height: 28px; color: #c5bdc5; font-size: 17px; text-align: center; }
.save-list { width: 184px; height: 350px; margin-top: 8px; }
.save-item { width: 184px; height: 62px; margin-bottom: 7px; padding: 0px 14px; background-color: #2c2730; flex-direction: row; align-items: center; justify-content: space-between; border-radius: 10px; }
.add-item { background-color: #bb557f; align-items: center; justify-content: center; padding-left: 0px; }
.auto-save-item { background-color: #3b323b; }
.slot-title { color: #ffffff; font-size: 21px; font-weight: bold; }
.slot-meta { width: 80px; flex-direction: column; align-items: flex-end; }
.slot-info { color: #cfc6cf; font-size: 14px; }
.slot-time { color: #a9a1ab; font-size: 13px; margin-top: 3px; }
.empty { width: 184px; height: 350px; flex-direction: column; align-items: center; justify-content: center; }
.empty-text { color: #cfc6cf; font-size: 20px; text-align: center; }
.new-btn { width: 184px; height: 52px; line-height: 52px; margin-top: 20px; color: #ffffff; font-size: 21px; font-weight: bold; text-align: center; background-color: #bb557f; border-radius: 10px; }
.back-btn { width: 184px; height: 50px; line-height: 50px; color: #ffffff; font-size: 20px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 10px; }
.delete-scrim { position: absolute; top: 0px; left: 0px; width: 212px; height: 520px; background-color: #000000; opacity: 0.62; }
.delete-dialog { position: absolute; top: 184px; left: 20px; width: 144px; height: 152px; padding: 14px; background-color: #2c2730; border-radius: 14px; flex-direction: column; align-items: center; }
.delete-title { width: 144px; color: #ffffff; font-size: 22px; font-weight: bold; text-align: center; }
.delete-copy { width: 144px; margin-top: 8px; color: #cfc6cf; font-size: 15px; text-align: center; }
.delete-actions { width: 144px; height: 42px; margin-top: 20px; flex-direction: row; justify-content: space-between; }
.delete-cancel, .delete-confirm { width: 68px; height: 42px; line-height: 42px; color: #ffffff; font-size: 18px; font-weight: bold; text-align: center; border-radius: 10px; }
.delete-cancel { background-color: #4a414b; }
.delete-confirm { background-color: #bb557f; }

@media (shape: rect) {
  .page { width: 212px; height: 303px; }
  .page-title { height: 34px; line-height: 34px; font-size: 17px; }
  .page-subtitle { width: 188px; height: 18px; line-height: 18px; font-size: 11px; }
  .save-list, .empty { width: 188px; height: 204px; margin-top: 3px; }
  .save-item { width: 188px; height: 42px; margin-bottom: 4px; padding: 0px 10px; border-radius: 8px; }
  .slot-title { font-size: 14px; }
  .slot-meta { width: 88px; }
  .slot-info { font-size: 11px; }
  .slot-time { font-size: 10px; margin-top: 1px; }
  .empty-text { font-size: 15px; }
  .new-btn { width: 164px; height: 36px; line-height: 36px; margin-top: 12px; font-size: 15px; border-radius: 8px; }
  .back-btn { width: 188px; height: 34px; line-height: 34px; font-size: 14px; border-radius: 8px; }
  .delete-scrim { width: 212px; height: 303px; }
  .delete-dialog { top: 82px; left: 20px; width: 144px; height: 120px; padding: 14px; border-radius: 10px; }
  .delete-title { width: 144px; font-size: 16px; }
  .delete-copy { width: 144px; margin-top: 5px; font-size: 11px; }
  .delete-actions { width: 144px; height: 32px; margin-top: 14px; }
  .delete-cancel, .delete-confirm { width: 68px; height: 32px; line-height: 32px; font-size: 14px; border-radius: 8px; }
}
</style>
