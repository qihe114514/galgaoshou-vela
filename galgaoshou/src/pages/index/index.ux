<template>
  <div class="page" @swipe="ban">
    <image id="home-bg" static class="home-background" src="/common/home.png"></image>
    <div id="home-shade" class="home-shade"></div>
    <image id="home-logo" static class="home-logo {{homeStaticClass}}" src="/common/logo.png"></image>

    <div id="home-panel" class="home-panel {{homeStaticClass}}">
      <div id="home-resume" class="home-resume-layer {{homeStaticClass}}"><text class="resume-copy">{{resumeCopy}}</text></div>
      <div id="home-primary" class="home-primary-layer {{homeStaticClass}}"><text class="primary-action" @click="continueGame">{{primaryAction}}</text></div>
      <div id="home-secondary-row" class="secondary-row {{homeStaticClass}}">
        <text class="secondary-action" @click="startGame">新游戏</text>
        <text class="secondary-action" @click="openSaves">存档</text>
      </div>
      <div id="home-action-row" class="action-row {{homeStaticClass}}">
        <text class="compact-action" @click="openSettings">设置</text>
        <text class="compact-action" @click="openAbout">关于</text>
      </div>
      <div id="home-exit" class="home-exit-layer {{homeStaticClass}}"><text class="exit-action" @click="exit">退出</text></div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import folme from '@system.folme'

const HOME_MOTION_IDS = ['home-logo', 'home-panel', 'home-resume', 'home-primary', 'home-secondary-row', 'home-action-row', 'home-exit']
const HOME_INITIAL_STATE = {
  'home-logo': { translateY: '-180px' },
  'home-panel': { translateY: '223px' },
  'home-resume': { translateY: '223px' },
  'home-primary': { translateY: '223px' },
  'home-secondary-row': { translateY: '223px' },
  'home-action-row': { translateY: '223px' },
  'home-exit': { translateY: '223px' }
}
const HOME_FINAL_STATE = {
  'home-logo': { translateY: '0px' },
  'home-panel': { translateY: '0px' },
  'home-resume': { translateY: '0px' },
  'home-primary': { translateY: '0px' },
  'home-secondary-row': { translateY: '0px' },
  'home-action-row': { translateY: '0px' },
  'home-exit': { translateY: '0px' }
}

export default {
  private: { autoSaveData: null, resumeCopy: '从序章开始新的故事', primaryAction: '开始阅读', homeIntroToken: 0, homeIntroTimers: [], homeStaticClass: '' },
  onInit() { this.refreshAutoSave() },
  onShow() { this.refreshAutoSave(); this.playHomeIntro() },
  onHide() { this.cancelHomeIntro() },
  onDestroy() { this.cancelHomeIntro() },
  cancelHomeIntro() {
    this.homeIntroToken += 1
    for (const timer of this.homeIntroTimers) clearTimeout(timer)
    this.homeIntroTimers = []
  },
  playHomeIntro() {
    this.cancelHomeIntro()
    const token = this.homeIntroToken
    this.homeStaticClass = ''
    const start = setTimeout(() => {
      if (token !== this.homeIntroToken) return
      if (!this.setHomeInitialState()) return
      this.scheduleHomeMotion(token, ['home-logo', 'home-panel'], 200)
      this.scheduleHomeMotion(token, ['home-resume'], 360)
      this.scheduleHomeMotion(token, ['home-primary'], 420)
      this.scheduleHomeMotion(token, ['home-secondary-row'], 480)
      this.scheduleHomeMotion(token, ['home-action-row'], 540)
      this.scheduleHomeMotion(token, ['home-exit'], 600)
    }, 16)
    this.homeIntroTimers.push(start)
  },
  setHomeInitialState() {
    try {
      if (!folme || typeof folme.setTo !== 'function') throw new Error('folme unavailable')
      for (const id of HOME_MOTION_IDS) folme.setTo({ id, toState: { translateY: HOME_INITIAL_STATE[id].translateY } })
      return true
    } catch (error) {
      this.homeStaticClass = 'home-static'
      return false
    }
  },
  scheduleHomeMotion(token, ids, delay) {
    const timer = setTimeout(() => {
      if (token !== this.homeIntroToken) return
      this.runHomeMotion(ids, HOME_FINAL_STATE, 0.25)
    }, delay)
    this.homeIntroTimers.push(timer)
  },
  runHomeMotion(ids, targets, duration) {
    try {
      const frames = ids.map((id) => ({ id, toState: { translateY: { value: targets[id].translateY } }, config: { duration } }))
      if (!folme) throw new Error('folme unavailable')
      if (typeof folme.startGroup === 'function') folme.startGroup(frames)
      else if (typeof folme.to === 'function') frames.forEach((frame) => folme.to(frame))
      else throw new Error('folme unavailable')
      return true
    } catch (error) {
      this.homeStaticClass = 'home-static'
      this.cancelHomeIntro()
      return false
    }
  },
  refreshAutoSave() {
    this.autoSaveData = null
    storage.get({
      key: 'autoSave',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          if (Number.isInteger(Number(saved && saved.currentScene)) && Number(saved.currentScene) >= 0) this.autoSaveData = saved
        } catch (error) {}
        this.refreshResumeState()
      },
      fail: () => this.refreshResumeState()
    })
  },
  refreshResumeState() {
    if (this.autoSaveData) {
      this.resumeCopy = `最近进度 · 第${Number(this.autoSaveData.chapter || 0) + 1}章 · 场景${Number(this.autoSaveData.currentScene) + 1}`
      this.primaryAction = '继续阅读'
      return
    }
    this.resumeCopy = '从序章开始新的故事'
    this.primaryAction = '开始阅读'
  },
  continueGame() {
    if (this.autoSaveData) return router.push({ uri: 'pages/detail', params: { auto: '1' } })
    this.startGame()
  },
  startGame() { router.push({ uri: 'pages/detail' }) },
  openSaves() { router.push({ uri: 'pages/saves', params: { mode: 'load' } }) },
  openSettings() { router.push({ uri: 'pages/settings' }) },
  openAbout() { router.push({ uri: 'pages/about' }) },
  exit() { this.$app.exit() },
  ban() {}
}
</script>

<style>
.page { width: 192px; height: 490px; overflow: hidden; background-color: #160f16; }
.home-background { position: absolute; top: 0px; left: 0px; width: 192px; height: 490px; object-fit: cover; }
.home-shade { position: absolute; top: 0px; left: 0px; width: 192px; height: 490px; background-color: #240f1a; opacity: 0.10; }
.home-logo { position: absolute; top: 90px; left: 14px; width: 163px; height: 93px; background-color: transparent; object-fit: contain; transform: translateY(-180px); }
.home-panel { position: absolute; top: 267px; left: 0px; width: 192px; height: 223px; background-color: rgba(255,242,246,0.78); border-radius: 14px 14px 0px 0px; flex-direction: column; align-items: center; transform: translateY(223px); }
.home-resume-layer { width: 192px; height: 19px; margin-top: 8px; transform: translateY(223px); }
.home-primary-layer { width: 159px; height: 47px; margin-top: 8px; transform: translateY(223px); }
.resume-copy { width: 100%; height: 100%; margin-top: 0px; color: #754056; font-size: 14px; font-weight: bold; text-align: center; text-overflow: ellipsis; lines: 1; }
.primary-action { width: 100%; height: 100%; margin-top: 0px; background-color: #b95079; color: #ffffff; font-size: 22px; font-weight: bold; text-align: center; border-radius: 10px; }
.secondary-row { width: 159px; height: 36px; margin-top: 6px; flex-direction: row; justify-content: space-between; transform: translateY(223px); }
.secondary-action { width: 76px; height: 36px; background-color: #ead1da; color: #722c4b; font-size: 17px; font-weight: bold; text-align: center; border-radius: 10px; }
.action-row { width: 159px; height: 36px; margin-top: 6px; flex-direction: row; justify-content: space-between; transform: translateY(223px); }
.compact-action { width: 76px; height: 36px; background-color: #ead1da; color: #722c4b; font-size: 17px; font-weight: bold; text-align: center; border-radius: 10px; }
.home-exit-layer { width: 159px; height: 38px; margin-top: 8px; transform: translateY(223px); }
.exit-action { width: 100%; height: 100%; margin-top: 0px; background-color: #d9bac8; color: #722c4b; font-size: 19px; font-weight: bold; text-align: center; border-radius: 10px; }
.home-static { transform: translateY(0px); }
</style>
