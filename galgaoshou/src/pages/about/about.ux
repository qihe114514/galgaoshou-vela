<template>
  <div class="page">
    <text class="page-title">关于</text>
    <scroll id="about-content" class="content {{motionStaticClass}}" scroll-y="true" bounces="false" @swipe="blockSystemBack">
      <image static class="about-text" src="/common/about-text.png"></image>
      <div class="group-section">
        <text class="group-title">加入官方QQ群</text>
        <text class="group-copy">群内抽取Steam原作CDK</text>
        <image static class="group-qr" src="/common/qq-group-qrcode.png"></image>
        <text class="group-number">群号 1105166284</text>
      </div>
    </scroll>
    <text class="back-btn" @click="back">返回</text>
  </div>
</template>

<script>
import router from '@system.router'
import createPageMotion from '../../common/page-motion'

const ABOUT_INITIAL_STATE = { 'about-content': '0px' }

export default {
  private: { motionStaticClass: '' },
  onInit() { this.motion = createPageMotion(ABOUT_INITIAL_STATE, () => { this.motionStaticClass = 'motion-static' }) },
  onShow() { this.playIntro() },
  onHide() { if (this.motion) this.motion.cancel() },
  onDestroy() { if (this.motion) this.motion.cancel() },
  playIntro() {
    if (!this.motion) return
    this.motionStaticClass = ''
    this.motion.play([{ ids: ['about-content'], delay: 0 }])
  },
  back() { router.back() },
  blockSystemBack() {}
}
</script>

<style>
.page { width: 192px; height: 490px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { width: 100%; margin-bottom: 2px; line-height: 54px; color: #ffffff; font-size: 28px; font-weight: bold; text-align: center; }
.content { width: 188px; flex: 1; height: auto; overflow: hidden; flex-direction: column; flex-wrap: nowrap; transform: translateY(0px); }
.about-text { width: 188px; height: 1400px; }
.group-section { width: 188px; padding: 18px 0px 24px; flex-direction: column; align-items: center; }
.group-title { width: 188px; color: #f2c6d7; font-size: 20px; font-weight: bold; text-align: center; }
.group-copy { width: 188px; margin-top: 4px; color: #d9bac8; font-size: 13px; text-align: center; }
.group-qr { width: 112px; height: 112px; margin-top: 10px; object-fit: contain; }
.group-number { width: 188px; margin-top: 6px; color: #f2c6d7; font-size: 16px; font-weight: bold; text-align: center; }
.back-btn { width: 166px; height: 47px; margin-top: 8px; margin-bottom: 10px; line-height: 47px; color: #ffffff; font-size: 20px; font-weight: bold; text-align: center; background-color: #302b33; border-radius: 10px; }
.motion-static { transform: translateY(0px); }

@media (shape: rect) {
  .page { height: 303px; }
  .page-title { height: 34px; margin-bottom: 0px; line-height: 34px; font-size: 18px; }
  .content { flex: 1; }
  .group-section { padding: 12px 0px 16px; }
  .group-title { font-size: 15px; }
  .group-copy { margin-top: 3px; font-size: 10px; }
  .group-qr { width: 80px; height: 80px; margin-top: 7px; }
  .group-number { margin-top: 4px; font-size: 12px; }
  .back-btn { width: 188px; height: 34px; margin-top: 4px; margin-bottom: 5px; line-height: 34px; font-size: 14px; border-radius: 8px; }
}
</style>

