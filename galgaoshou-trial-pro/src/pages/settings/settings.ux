<template>
  <div class="page">
    <text class="page-title">设置</text>
    <div class="content-section speed-section">
      <text class="label">显示速度 {{settings.textSpeed}}</text>
      <slider class="slider" min="0" max="50" step="5" value="{{settings.textSpeed}}" onchange="changeTextSpeed"></slider>
      <text class="hint">0 为立即显示</text>
    </div>

    <div class="content-section size-section">
      <text class="label size-label">文字大小 {{settings.textSize}}</text>
      <slider class="slider" min="20" max="36" step="2" value="{{settings.textSize}}" onchange="changeTextSize"></slider>
    </div>

    <div class="preview-screen">
      <div class="preview-panel"></div>
      <text class="preview-name">其核</text>
      <scroll class="preview-scroll" scroll-y="true" bounces="false">
        <text class="preview-dialogue preview-dialogue-small" if="{{textSmall}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
        <text class="preview-dialogue preview-dialogue-medium" if="{{textMedium}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
        <text class="preview-dialogue preview-dialogue-large" if="{{textLarge}}">这是一段较长的对白预览。文字大小会直接影响这里的显示效果，让你在进入故事前确认阅读时是否舒适。即使对白持续延伸，也可以在这个小窗口里查看行距和整体层次。</text>
      </scroll>
    </div>
    <div class="actions">
      <text class="secondary-btn" @click="resetSettings">重置</text>
      <text class="primary-btn" @click="saveSettings">保存</text>
      <text class="back-btn" @click="back">返回</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import prompt from '@system.prompt'

const DEFAULT_SETTINGS = { textSpeed: 25, textSize: 22 }

export default {
  private: { settings: DEFAULT_SETTINGS, textSmall: true, textMedium: false, textLarge: false },
  onInit() {
    storage.get({
      key: 'settings',
      success: (data) => {
        try {
          const saved = JSON.parse(data)
          this.settings = Object.assign({}, DEFAULT_SETTINGS, saved, {
            textSpeed: Number.isFinite(Number(saved.textSpeed)) ? Number(saved.textSpeed) : DEFAULT_SETTINGS.textSpeed,
            textSize: Number.isFinite(Number(saved.textSize)) ? Number(saved.textSize) : DEFAULT_SETTINGS.textSize
          })
          this.setPreviewTextSize(this.settings.textSize)
        } catch (error) {}
      },
      fail: () => {}
    })
  },
  changeTextSpeed(event) { this.settings = Object.assign({}, this.settings, { textSpeed: event.progress }) },
  changeTextSize(event) { this.settings = Object.assign({}, this.settings, { textSize: event.progress }); this.setPreviewTextSize(event.progress) },
  resetSettings() { this.settings = Object.assign({}, DEFAULT_SETTINGS); this.setPreviewTextSize(this.settings.textSize) },
  setPreviewTextSize(size) {
    const textSize = Number(size) || DEFAULT_SETTINGS.textSize
    this.textSmall = textSize <= 22
    this.textMedium = textSize > 22 && textSize <= 30
    this.textLarge = textSize > 30
  },
  saveSettings() {
    storage.set({
      key: 'settings',
      value: JSON.stringify(this.settings),
      success: () => prompt.showToast({ message: '设置已保存' }),
      fail: () => prompt.showToast({ message: '保存失败' })
    })
  },
  back() { router.back() }
}
</script>

<style>
.page { width: 212px; height: 520px; overflow: hidden; background-color: #17151a; flex-direction: column; align-items: center; }
.page-title { width: 100%; height: 58px; line-height: 58px; color: #ffffff; font-size: 26px; font-weight: bold; text-align: center; }
.content-section { width: 212px; flex-direction: column; }
.speed-section { height: 88px; }
.size-section { height: 70px; }
.label { width: 180px; margin-left: 16px; color: #ffffff; font-size: 20px; font-weight: bold; }
.slider { width: 180px; height: 38px; margin-left: 16px; color: #c75a84; }
.hint { width: 180px; margin-left: 16px; color: #bdb8bf; font-size: 14px; }
.size-label { margin-top: 4px; }
.preview-screen { position: relative; width: 212px; height: 132px; margin-top: 12px; }
.preview-panel { position: absolute; top: 0px; left: 0px; width: 212px; height: 132px; background-color: rgba(18,13,19,0.30); border-radius: 12px 12px 0px 0px; }
.preview-name { position: absolute; top: 8px; left: 10px; color: #ffd8e6; font-size: 20px; font-weight: bold; }
.preview-scroll { position: absolute; top: 36px; left: 0px; width: 212px; height: 88px; overflow: hidden; }
.preview-dialogue { width: 212px; color: #ffffff; font-weight: bold; line-height: 30px; }
.preview-dialogue-small { font-size: 20px; }
.preview-dialogue-medium { font-size: 24px; line-height: 34px; }
.preview-dialogue-large { font-size: 28px; line-height: 38px; }
.actions { width: 184px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.primary-btn, .secondary-btn, .back-btn { height: 50px; line-height: 50px; color: #ffffff; font-size: 20px; font-weight: bold; text-align: center; }
.primary-btn { width: 88px; background-color: #bb557f; border-radius: 10px; }
.secondary-btn { width: 88px; background-color: #4a414b; border-radius: 10px; }
.back-btn { width: 184px; margin-top: 10px; background-color: #302b33; border-radius: 10px; }

@media (shape: rect) {
  .page { width: 212px; height: 303px; }
  .page-title { height: 32px; line-height: 32px; font-size: 17px; }
  .content-section { width: 212px; overflow: hidden; }
  .speed-section { height: 58px; }
  .size-section { height: 43px; }
  .label { width: 180px; margin-left: 16px; font-size: 14px; }
  .slider { width: 180px; height: 24px; margin-left: 16px; }
  .hint { width: 180px; margin-left: 16px; font-size: 10px; }
  .size-label { margin-top: 5px; }
  .preview-screen { width: 212px; height: 58px; margin-top: 5px; }
  .preview-panel { width: 212px; height: 58px; border-radius: 8px 8px 0px 0px; }
  .preview-name { top: 4px; left: 10px; font-size: 13px; }
  .preview-scroll { top: 22px; width: 212px; height: 32px; }
  .preview-dialogue { line-height: 16px; }
  .preview-dialogue-small { font-size: 11px; }
  .preview-dialogue-medium { font-size: 13px; line-height: 18px; }
  .preview-dialogue-large { font-size: 15px; line-height: 20px; }
  .actions { width: 184px; height: 68px; }
  .primary-btn, .secondary-btn, .back-btn { height: 32px; line-height: 32px; font-size: 14px; border-radius: 8px; }
  .primary-btn, .secondary-btn { width: 88px; }
  .back-btn { width: 184px; margin-top: 4px; }
}
@media (shape: circle) { .page { width: 240px; height: 240px; } .page-title { height: 32px; line-height: 32px; font-size: 16px; } .content-section { width: 190px; height: 150px; } .label, .slider, .hint { width: 175px; margin-left: 8px; } .label { font-size: 12px; } .slider { height: 20px; } .hint { font-size: 9px; } .size-label { margin-top: 4px; } .preview-screen, .preview-panel { width: 190px; height: 49px; } .preview-screen { margin-top: 4px; } .preview-name { top: 3px; left: 8px; font-size: 11px; } .preview-scroll { top: 18px; width: 190px; height: 27px; } .preview-dialogue { width: 190px; line-height: 13px; } .preview-dialogue-small { font-size: 10px; } .preview-dialogue-medium { font-size: 11px; line-height: 14px; } .preview-dialogue-large { font-size: 13px; line-height: 16px; } .actions { width: 175px; height: 51px; } .primary-btn, .secondary-btn, .back-btn { height: 25px; line-height: 25px; font-size: 11px; } .primary-btn, .secondary-btn { width: 83px; } .back-btn { width: 175px; margin-top: 2px; } }
</style>
